generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MODELOS DE AUTENTICAÇÃO (NextAuth)
// ============================================

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  password      String
  hash          String          @unique  // Hash único de 10 caracteres (nanoid)
  image         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Google Drive Integration
  googleDriveAccessToken  String?   @db.Text
  googleDriveRefreshToken String?   @db.Text
  googleDriveTokenExpiry  DateTime?

  // Relações
  accounts         Account[]
  sessions         Session[]
  disciplinas      Disciplina[]
  materiaisEstudo  MaterialEstudo[]
  planosEstudo     PlanoEstudo[]
  simulados        Simulado[]

  @@index([hash])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("admin") // admin, super_admin
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([active])
}

// ============================================
// MODELOS DE DOMÍNIO
// ============================================

model Disciplina {
  id            String               @id @default(cuid())
  userId        String
  nome          String
  descricao     String?
  cargaHoraria  Int                  @default(0)
  peso          Float                @default(1.0)
  cor           String?              @default("#3b82f6")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  materiais     DisciplinaMaterial[]
  semanasEstudo DisciplinaSemana[]
  simulados     SimuladoDisciplina[]

  @@index([userId])
  @@index([nome])
}

model MaterialEstudo {
  id                  String               @id @default(cuid())
  userId              String
  nome                String
  tipo                String               @default("PDF")  // PDF ou VIDEO
  totalPaginas        Int
  paginasLidas        Int                  @default(0)
  duracaoSegundos     Int?                 // Duração do vídeo em segundos (para vídeos)
  tempoAssistido      Int?                 @default(0) // Tempo assistido em segundos (para vídeos)
  arquivoPdfUrl       String?              // Opcional - PDFs armazenados no IndexedDB
  arquivoVideoUrl     String?              // Opcional - Vídeos armazenados no IndexedDB ou URL de streaming
  googleDriveFileId   String?              // FileId do Google Drive (para vídeos)
  googleDriveFileName String?              // Nome original do arquivo no Google Drive
  fonteOrigem         String?              // Fonte de origem (ex: "Google Drive: path/to/file")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  anotacoes           Anotacao[]
  disciplinas         DisciplinaMaterial[]
  historicoLeitura    HistoricoLeitura[]
  mobileText          PdfMobileText?       // Texto formatado para mobile

  @@index([userId])
  @@index([tipo])
  @@index([googleDriveFileId])
}

model DisciplinaMaterial {
  id           String         @id @default(cuid())
  disciplinaId String
  materialId   String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  disciplina   Disciplina     @relation(fields: [disciplinaId], references: [id])
  material     MaterialEstudo @relation(fields: [materialId], references: [id])

  @@unique([disciplinaId, materialId])
}

model HistoricoLeitura {
  id                   String         @id @default(cuid())
  materialId           String
  paginaAtual          Int
  tempoLeituraSegundos Int
  dataLeitura          DateTime       @default(now())
  createdAt            DateTime       @default(now())
  assuntosEstudados    String?
  nomeSessao           String?
  material             MaterialEstudo @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([dataLeitura])
  @@index([paginaAtual])
}

model Anotacao {
  id         String         @id @default(cuid())
  materialId String
  pagina     Int
  texto      String
  posicaoX   Float?
  posicaoY   Float?
  largura    Float?
  altura     Float?
  cor        String?        @default("#ffff00")
  tipo       String         @default("highlight")
  // Campos para anotações em texto formatado (mobile reader)
  startOffset Int?          // Posição inicial no texto (char index)
  endOffset   Int?          // Posição final no texto (char index)
  metadata    Json?         // Metadados adicionais (ex: paths para freehand, configs de underline)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  material   MaterialEstudo @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([pagina])
  @@index([tipo])
  @@index([createdAt])
}

// Texto formatado para leitura mobile (e-reader style)
model PdfMobileText {
  id                String         @id @default(cuid())
  materialId        String         @unique // Um material = um texto formatado
  formattedText     String         @db.Text // Texto em markdown formatado pela IA
  rawText           String         @db.Text // Texto bruto extraído do PDF (backup)
  processedAt       DateTime       @default(now())
  aiModel           String?        @default("gpt-4o-mini") // Modelo usado para formatação
  tokensUsed        Int?           // Tokens consumidos na formatação

  // Campos para processamento incremental
  totalPages        Int            @default(0) // Total de páginas no PDF
  processedPages    Int            @default(0) // Número de páginas processadas
  processingStatus  String         @default("pending") // pending, processing, partial, complete, error
  lastProcessedPage Int            @default(0) // Última página processada
  processingError   String?        // Mensagem de erro se houver
  retryCount        Int            @default(0) // Contador de tentativas de processamento

  // Padrões de cabeçalho/rodapé detectados pela IA
  headerFooterPatterns String?     @db.Text // JSON com padrões regex detectados pela IA

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  material          MaterialEstudo @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@index([processedAt])
  @@index([processingStatus])
}

model PlanoEstudo {
  id         String         @id @default(cuid())
  userId     String
  nome       String
  descricao  String?
  dataInicio DateTime
  dataFim    DateTime
  ativo      Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  semanas    SemanaEstudo[]

  @@index([userId])
  @@index([ativo])
  @@index([dataInicio])
  @@index([dataFim])
}

model SemanaEstudo {
  id              String             @id @default(cuid())
  planoId         String
  numeroSemana    Int
  dataInicio      DateTime
  dataFim         DateTime
  observacoes     String?
  totalHoras      Int                @default(0)
  horasRealizadas Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  disciplinas     DisciplinaSemana[]
  plano           PlanoEstudo        @relation(fields: [planoId], references: [id], onDelete: Cascade)
  simulados       Simulado[]

  @@unique([planoId, numeroSemana])
  @@index([planoId])
  @@index([numeroSemana])
  @@index([dataInicio])
}

model DisciplinaSemana {
  id                  String          @id @default(cuid())
  semanaId            String
  disciplinaId        String
  horasPlanejadas     Int
  horasRealizadas     Int             @default(0)
  prioridade          Int             @default(1)
  observacoes         String?
  concluida           Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  materialNome        String?
  materialUrl         String?
  paginasLidas        Int             @default(0)
  questoesPlanejadas  Int             @default(0)
  questoesRealizadas  Int             @default(0)
  tempoVideoPlanejado Int             @default(0)
  tempoVideoRealizado Int             @default(0)
  tipoVeiculo         String?
  totalPaginas        Int             @default(0)
  diasEstudo          String?
  disciplina          Disciplina      @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  semana              SemanaEstudo    @relation(fields: [semanaId], references: [id], onDelete: Cascade)
  dias                DisciplinaDia[] // Relação com DisciplinaDia

  @@unique([semanaId, disciplinaId])
  @@index([semanaId])
  @@index([disciplinaId])
  @@index([prioridade])
}

model DisciplinaDia {
  id                  String           @id @default(cuid())
  disciplinaSemanaId  String
  dia                 String           // "dia1", "dia2", "dia3", "dia4", "dia5", "dia6", "dia7"
  horasPlanejadas     Float            @default(0) // Horas específicas para este dia
  horasRealizadas     Float            @default(0) // Horas realizadas neste dia
  questoesPlanejadas  Int              @default(0) // Questões planejadas para este dia
  questoesRealizadas  Int              @default(0) // Questões realizadas neste dia
  observacoes         String?          // Observações específicas do dia
  concluida           Boolean          @default(false) // Se o estudo deste dia foi concluído
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  disciplinaSemana    DisciplinaSemana @relation(fields: [disciplinaSemanaId], references: [id], onDelete: Cascade)

  @@unique([disciplinaSemanaId, dia])
  @@index([disciplinaSemanaId])
  @@index([dia])
}

// ============================================
// MÓDULO DE SIMULADOS
// ============================================

model Simulado {
  id                    String              @id @default(cuid())
  userId                String
  semanaEstudoId        String?             // Referência à semana de estudos (SemanaEstudo)
  nome                  String
  descricao             String?
  dataRealizacao        DateTime            @default(now())
  status                String              @default("em_andamento") // em_andamento, finalizado, cancelado
  tempoTotalSegundos    Int?                // Tempo total gasto no simulado

  // Gabaritos
  gabaritoOficialUrl    String?             // URL do arquivo do gabarito oficial
  gabaritoUsuarioUrl    String?             // URL do arquivo do gabarito do usuário

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relações
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  semanaEstudo          SemanaEstudo?       @relation(fields: [semanaEstudoId], references: [id], onDelete: SetNull)
  disciplinas           SimuladoDisciplina[] // Disciplinas do simulado com seus status
  questoes              QuestaoSimulado[]   // Questões do simulado

  @@index([userId])
  @@index([semanaEstudoId])
  @@index([dataRealizacao])
  @@index([status])
}

model SimuladoDisciplina {
  id                    String      @id @default(cuid())
  simuladoId            String
  disciplinaId          String

  // Intervalo de questões da disciplina no simulado
  questaoInicio         Int?        // Primeira questão da disciplina (ex: 1)
  questaoFim            Int?        // Última questão da disciplina (ex: 20)

  // Critérios configuráveis para definição do status (semáforo)
  limiteVermelho        Float       @default(50.0)  // < 50% = vermelho
  limiteAmarelo         Float       @default(70.0)  // >= 50% e < 70% = amarelo, >= 70% = verde

  // Evolução da disciplina
  simuladoAnteriorId    String?     // ID do SimuladoDisciplina anterior para comparar evolução

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  // Relações
  simulado              Simulado    @relation(fields: [simuladoId], references: [id], onDelete: Cascade)
  disciplina            Disciplina  @relation(fields: [disciplinaId], references: [id], onDelete: Cascade)
  questoes              QuestaoSimulado[] // Questões específicas desta disciplina

  @@unique([simuladoId, disciplinaId])
  @@index([simuladoId])
  @@index([disciplinaId])
}

model QuestaoSimulado {
  id                    String              @id @default(cuid())
  simuladoId            String
  simuladoDisciplinaId  String

  // Dados da questão
  enunciado             String              @db.Text
  alternativaA          String
  alternativaB          String
  alternativaC          String
  alternativaD          String
  alternativaE          String?
  respostaCorreta       String              // A, B, C, D ou E

  // Resposta do usuário
  respostaUsuario       String?             // A, B, C, D, E ou null (não respondida)
  acertou               Boolean?            // true, false ou null

  // Metadados
  nivel                 String?             @default("medio") // facil, medio, dificil
  assunto               String?             // Tópico específico da disciplina
  tempoRespostaSegundos Int?                // Tempo gasto nesta questão
  explicacao            String?             @db.Text // Explicação da resposta

  // Origem da questão
  bancaOrigem           String?             // Ex: CESPE, FCC, FGV
  anoProva              Int?
  orgaoProva            String?

  ordem                 Int                 @default(0) // Ordem no simulado

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relações
  simulado              Simulado            @relation(fields: [simuladoId], references: [id], onDelete: Cascade)
  simuladoDisciplina    SimuladoDisciplina  @relation(fields: [simuladoDisciplinaId], references: [id], onDelete: Cascade)

  @@index([simuladoId])
  @@index([simuladoDisciplinaId])
  @@index([acertou])
  @@index([nivel])
  @@index([ordem])
}
